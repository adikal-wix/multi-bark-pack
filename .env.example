# WhatsApp
WA_ENABLED=true
WA_GROUP=bark-pack

# Telegram (uncomment to enable)
# TELEGRAM_TOKEN=
# TELEGRAM_CHAT_ID=

# Slack (uncomment to enable — requires Socket Mode)
# Bot responds to @mentions in any channel it's in
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...

# Owner filter — REQUIRED per platform (no owner = bot ignores all messages)
# Comma-separated for multiple owners, or DANGER-ALL to allow everyone
# WA_OWNER=972501234567,972509876543
# TG_OWNER=123456789
# SLACK_OWNER=U0123456789,U07B2K3LFMN

# Voice transcription (optional) — macOS/Homebrew default shown
# Override if your whisper model is in a different location
# WHISPER_MODEL=/opt/homebrew/share/whisper-cpp/models/ggml-base.en.bin
